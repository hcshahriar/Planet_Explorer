<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Active State: Neon Cyan Glow when tapped/focused -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A284A" />
            <stroke android:width="2dp" android:color="#00F2FE" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Default State: Dark space-themed background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#131B36" />
            <stroke android:width="1dp" android:color="#202C4E" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>