<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#050816"
    android:fitsSystemWindows="true">

    <!-- App Title Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_planet_explorer"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:padding="20dp"/>

    <!-- Search Bar + Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/searchView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="#131B36"
            app:queryHint="Search planet..."
            app:iconifiedByDefault="false" />

        <!-- NASA Hub Button (Glowing Star Logo) -->
        <ImageView
            android:id="@+id/btnNasaHub"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="#131B36"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="NASA Hub"
            android:src="@drawable/ic_nasa_logo" />

        <!-- Favorites Filter Button -->
        <ImageView
            android:id="@+id/btnFavFilter"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="#131B36"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Filter Favorites"
            android:src="@drawable/ic_heart_outline" />

        <!-- Planet Compare Button -->
        <ImageView
            android:id="@+id/btnCompare"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="#131B36"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Compare Planets"
            android:src="@android:drawable/ic_menu_compass"
            app:tint="#FFFFFF" />

        <!-- Space Quiz Button -->
        <ImageView
            android:id="@+id/btnQuiz"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="#131B36"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Space Quiz"
            android:src="@android:drawable/ic_dialog_info"
            app:tint="#FFFFFF" />

        <!-- Logout Button -->
        <ImageView
            android:id="@+id/btnLogout"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="#131B36"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Logout"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#FFFFFF" />

    </LinearLayout>

    <!-- Main Planets List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>